# Donorbook — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project-id.supabase.co"

# Same values exposed to the Vite client bundle
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Service role key — server-side only, NEVER expose to the browser
# Find in: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Email via Resend (optional — emails are skipped if absent) ────────────────
# https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@donorbook.co.uk"

# ── App identity (optional — defaults to Donorbook values) ───────────────────
VITE_APP_NAME="Donorbook"
